# คัดลอกเป็น .env แล้วเติมค่าจริง (.env อยู่ใน .gitignore ห้าม commit)
# ตอน dev บนเครื่องตัวเองใช้ dotnet user-secrets แทนได้ ไม่ต้องมีไฟล์นี้

# Neon: Dashboard → Connection string → เลือกแบบ .NET (Npgsql)
ConnectionStrings__Default=Host=...;Database=...;Username=...;Password=...;SSL Mode=Require

# Google OAuth: console.cloud.google.com → Credentials → OAuth client (Web)
# Authorized redirect URI ต้องเป็น https://โดเมนของคุณ/api/signin-google (มี /api นำหน้า)
Google__ClientId=
Google__ClientSecret=

# ครูคนแรกตอนระบบยังว่าง คั่นหลายคนด้วย comma คนแรกเป็นผู้ดูแลระบบ
# ใช้ตอน bootstrap เท่านั้น ถ้ามีครูในตารางแล้วค่านี้จะไม่ถูกใช้
TEACHER_EMAILS=
